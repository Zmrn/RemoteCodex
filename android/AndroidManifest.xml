<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.anso.remotecodex" android:versionCode="__VERSION_CODE__" android:versionName="__VERSION__">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
