{
  "schemaVersion": 1,
  "updateDiscovery": {
    "manifestUrl": "https://persistent.oaistatic.com/codex-app-prod/windows-store-update.json",
    "schemaVersion": 1,
    "packageIdentity": "OpenAI.Codex"
  },
  "probeCandidates": [],
  "validation": [
    {
      "version": "26.901.6511.0",
      "date": "2026-09-09",
      "scope": "Codex existing desktop owner; read, create, send, queue, settings and image paths. See evidence for limits; Chat text and Work are not claimed validated.",
      "evidence": [
        "QUEUE-PREVIEW.md",
        "PROJECT-CREATION.md",
        "USAGE.md",
        "CHAT-MODE.md",
        "INTERRUPT.md",
        "CREATE-IMAGES.md"
      ]
    },
    {
      "version": "26.903.8094.0",
      "date": "2026-09-09",
      "scope": "Live Windows x64 official owner on laptop and local Microsoft VS Code shared IPC broker: text create/read, two-image native send in same created task, model/effort/read-only settings, queue add/remove, viewer reconnect without stopping active turn, interrupt and same-task continuation. Project selection, questions/approval submission, native image generation, Chat writes and Work are not revalidated on this build.",
      "evidence": [
        "CREATE-IMAGES.md",
        "VSCODE-COEXISTENCE.md"
      ]
    }
  ],
  "support": {
    "officialProduct": "OpenAI.Codex (Windows ChatGPT.exe)",
    "platform": "windows-x64",
    "verifiedVersions": [
      "26.901.6511.0",
      "26.903.8094.0"
    ],
    "packagePrefix": "OpenAI.Codex_",
    "packageSuffix": "_x64__",
    "unknownVersionPolicy": "按当前连接的实际接口名单逐功能判断；缺失、不匹配或未知只禁用依赖该接口的操作。verifiedVersions仅记录历史行为验证，不是运行放行名单。",
    "codex": "核心读写已验证；具体范围及限制见 COMPATIBILITY.md",
    "chat": "列表/历史读取；文字续写待专用真实会话验证；新建/模型/图片未支持",
    "work": "没有独立验证；列表可能与 Chat 混合"
  },
  "discovery": {
    "ownerPipe": "codex-ipc",
    "toolsPipePrefix": "codex-browser-use-",
    "ownerImagePattern": "\\\\WindowsApps\\\\OpenAI\\.Codex_[^\\\\]+\\\\app\\\\ChatGPT\\.exe$",
    "sharedBroker": {
      "kind": "vscode",
      "executable": "Code.exe",
      "signatureStatus": "Valid",
      "publisherSimpleName": "Microsoft Corporation",
      "productName": "Visual Studio Code",
      "companyName": "Microsoft Corporation",
      "validation": {
        "officialVersion": "26.903.8094.0",
        "brokerVersion": "1.136.2",
        "extensionVersion": "26.903.61454",
        "evidence": "VSCODE-COEXISTENCE.md"
      }
    },
    "toolsNamespace": "codex_app",
    "hostId": "local"
  },
  "storage": {
    "globalStateFile": ".codex-global-state.json",
    "queueKey": "queued-follow-ups",
    "sessionIndexFile": "session_index.jsonl",
    "source": "official-disk, read-only; not live-state proof",
    "rolloutHistory": {
      "directories": ["sessions", "archived_sessions"],
      "format": "session_meta + event_msg/item_completed",
      "consumer": "src/rollout-history.mjs",
      "test": "test/rollout-history.test.mjs",
      "maxDirectoryEntries": 250000,
      "maxFileBytes": 4294967296,
      "maxRecordBytes": 67108864,
      "maxItems": 100000,
      "maxScanMs": 20000,
      "rule": "Only the current verified desktop home and a fresh local Codex list row authorize history display; offsets are ephemeral, historical completion never authorizes operations or read receipts."
    },
    "readState": {
      "key": "electron-thread-read-state-v1",
      "version": 1,
      "atomKey": "electron-persisted-atom-state",
      "legacyKey": "unread-thread-ids-by-host-v1",
      "verifiedVersions": [
        "26.903.8094.0"
      ],
      "maxBytes": 8388608,
      "authFile": "auth.json",
      "identityClaim": "https://api.openai.com/auth"
    }
  },
  "transport": {
    "headerBytes": 4,
    "byteOrder": "uint32-le",
    "maxInboundBytes": 268435456,
    "maxOutboundBytes": 33554432,
    "toolsList": "tools/list",
    "toolsCall": "tools/call",
    "toolsListParams": {
      "threadStartKind": "all"
    },
    "toolsJsonrpc": "2.0",
    "clientType": "remote-bridge-prototype",
    "discoveryRequest": "client-discovery-request",
    "discoveryResponse": "client-discovery-response",
    "noHandlerError": "no-handler-for-request"
  },
  "tools": {
    "listProjects": {
      "name": "list_projects",
      "request": [],
      "response": "projects[]",
      "purpose": "项目列表",
      "consumer": "src/bridge.mjs:projects",
      "test": "test/projects.test.mjs"
    },
    "listThreads": {
      "name": "list_threads",
      "request": [
        "limit"
      ],
      "response": "threads[], pinnedThreads[]",
      "purpose": "会话列表",
      "consumer": "src/bridge.mjs:threads, src/task-reports.mjs:collect",
      "test": "test/chat.test.mjs"
    },
    "readThread": {
      "name": "read_thread",
      "request": [
        "threadId",
        "turnLimit",
        "includeOutputs",
        "maxOutputCharsPerItem",
        "cursor",
        "hostId"
      ],
      "response": "thread, turns, nextCursor",
      "purpose": "历史读取",
      "consumer": "src/bridge.mjs:read, src/task-reports.mjs:collect",
      "test": "test/conversation-pages.test.mjs"
    },
    "createThread": {
      "name": "create_thread",
      "request": [
        "prompt",
        "target",
        "model",
        "thinking",
        "title"
      ],
      "response": "threadId required; clientThreadId-only response treated as outcome-unknown",
      "purpose": "新建真实任务",
      "consumer": "src/bridge.mjs:create",
      "test": "test/projects.test.mjs"
    },
    "sendMessage": {
      "name": "send_message_to_thread",
      "request": [
        "threadId",
        "prompt",
        "model",
        "thinking"
      ],
      "response": "official tool result",
      "purpose": "继续已有任务；Chat 分支未完成实测",
      "consumer": "src/bridge.mjs:send, nativeSend, chatSend",
      "test": "test/send-lifecycle.test.mjs"
    },
    "setTitle": {
      "name": "set_thread_title",
      "request": [
        "threadId",
        "title"
      ],
      "response": "threadId, title (submission acknowledgement; display uses subsequent official list)",
      "purpose": "用户主动修改 Codex 会话名；专用测试权限上下文命名",
      "consumer": "src/thread-titles.mjs:renameThread, src/bridge.mjs:permissionContext",
      "test": "test/thread-titles.test.mjs"
    },
    "navigate": {
      "name": "navigate_to_codex_page",
      "request": [
        "threadId"
      ],
      "response": "official tool result",
      "purpose": "打开官方窗口同一任务",
      "consumer": "src/bridge.mjs:open",
      "test": "test/core.test.mjs"
    },
    "waitThreads": {
      "name": "wait_threads",
      "request": [
        "targets",
        "timeoutMs"
      ],
      "response": "official tool result",
      "purpose": "等待任务状态",
      "consumer": "src/bridge.mjs:wait",
      "test": "test/context.test.mjs"
    },
    "usage": {
      "name": "get_usage_limits",
      "request": [],
      "response": "rateLimitsByLimitId, rateLimits",
      "purpose": "目标账号额度",
      "consumer": "src/bridge.mjs:usage",
      "test": "test/usage.test.mjs"
    }
  },
  "ipc": {
    "initialize": {
      "method": "initialize",
      "version": 1,
      "request": [
        "clientType"
      ],
      "response": [
        "result.clientId"
      ],
      "purpose": "连接桥接客户端",
      "consumer": "src/transport.mjs:connect",
      "test": "test/core.test.mjs"
    },
    "owner": {
      "method": "thread-owner-discovery",
      "version": 1,
      "request": [
        "hostId",
        "conversationId"
      ],
      "response": [
        "handledByClientId"
      ],
      "purpose": "发现任务所有者",
      "consumer": "src/desktop.mjs:owner",
      "test": "test/queue.test.mjs"
    },
    "following": {
      "method": "thread-stream-following-changed",
      "version": 1,
      "request": [
        "hostId",
        "conversationId",
        "following"
      ],
      "response": [],
      "purpose": "订阅/取消订阅；broadcast",
      "consumer": "src/desktop.mjs, src/bridge.mjs",
      "test": "test/subscriptions.test.mjs"
    },
    "settings": {
      "method": "thread-follower-update-thread-settings",
      "version": 1,
      "request": [
        "conversationId",
        "threadSettings"
      ],
      "response": [
        "handledByClientId"
      ],
      "purpose": "设置下一轮模型/权限/速度",
      "consumer": "src/bridge.mjs:updateSettings",
      "test": "test/settings.test.mjs"
    },
    "userInput": {
      "method": "thread-follower-submit-user-input",
      "version": 1,
      "request": [
        "conversationId",
        "requestId",
        "response.answers"
      ],
      "response": [
        "handledByClientId"
      ],
      "purpose": "回答官方待处理问题",
      "consumer": "src/bridge.mjs:answerQuestions",
      "test": "test/messages.test.mjs"
    },
    "steer": {
      "method": "thread-follower-steer-turn",
      "version": 1,
      "request": [
        "conversationId",
        "input",
        "restoreMessage",
        "clientUserMessageId",
        "attachments"
      ],
      "response": [
        "handledByClientId",
        "result.result.turnId"
      ],
      "purpose": "向同一个运行中任务调整方向",
      "consumer": "src/bridge.mjs:answerQuestions/nativeSteer, src/queue.mjs:mutate",
      "test": "test/steer.test.mjs"
    },
    "queueWrite": {
      "method": "thread-follower-set-queued-follow-ups-state",
      "version": 1,
      "request": [
        "conversationId",
        "state"
      ],
      "response": [
        "handledByClientId",
        "result.ok"
      ],
      "purpose": "替换该任务完整队列",
      "consumer": "src/queue.mjs:write",
      "test": "test/queue.test.mjs"
    },
    "interrupt": {
      "method": "thread-follower-interrupt-turn",
      "version": 4,
      "request": [
        "conversationId",
        "mode=user-stop",
        "expectedTurnId"
      ],
      "response": [
        "handledByClientId",
        "result.ok",
        "result.interruptedTurnId"
      ],
      "purpose": "用户停止当前 Codex 轮次；核对实时轮次和同一官方所有者；自动测试仍仅专用任务",
      "consumer": "src/bridge.mjs:interrupt",
      "test": "test/interrupt.test.mjs"
    },
    "start": {
      "method": "thread-follower-start-turn",
      "version": 2,
      "request": [
        "conversationId",
        "turnStart.request.threadId",
        "turnStart.request.input",
        "turnStart.request.clientUserMessageId"
      ],
      "response": [
        "handledByClientId",
        "result.result.turn.id"
      ],
      "purpose": "空闲任务中启动下一轮",
      "consumer": "src/bridge.mjs:nativeSend",
      "test": "test/multi-images.test.mjs"
    },
    "readStateChanged": {
      "method": "thread-read-state-changed",
      "version": 3,
      "request": [
        "hostId",
        "conversationId",
        "hasUnreadTurn",
        "context.identity",
        "context.executionHostKey"
      ],
      "response": [],
      "purpose": "用户读到当前回报后通知官方清除未读标记；broadcast，无逐轮条件回执",
      "consumer": "src/official-report-read.mjs",
      "test": "test/official-report-read.test.mjs"
    },
    "mcpElicitation": {
      "method": "thread-follower-submit-mcp-server-elicitation-response",
      "version": 1,
      "request": [
        "conversationId",
        "requestId",
        "response"
      ],
      "response": [
        "handledByClientId",
        "result.result.ok"
      ],
      "purpose": "用户处理浏览器网站访问授权；不扩大为任意 MCP 表单或所有网站授权",
      "consumer": "src/approvals.mjs:answerApproval",
      "test": "test/approvals.test.mjs"
    }
  },
  "events": {
    "stream": {
      "method": "thread-stream-state-changed",
      "fields": [
        "conversationId",
        "hostId",
        "change.type",
        "change.revision",
        "change.baseRevision",
        "change.conversationState",
        "change.patches"
      ],
      "consumer": "src/bridge.mjs:frame"
    },
    "queue": {
      "method": "thread-queued-followups-changed",
      "fields": [
        "conversationId",
        "messages"
      ],
      "consumer": "src/queue.mjs:frame"
    },
    "userInput": {
      "method": "item/tool/requestUserInput",
      "fields": [
        "id",
        "params.questions"
      ],
      "consumer": "src/bridge.mjs:answerQuestions, public/app.js"
    },
    "mcpElicitation": {
      "method": "mcpServer/elicitation/request",
      "fields": [
        "id",
        "params.threadId",
        "params.turnId",
        "params.serverName",
        "params.mode",
        "params.message",
        "params.requestedSchema",
        "params._meta"
      ],
      "consumer": "src/approvals.mjs:pendingApprovals",
      "test": "test/approvals.test.mjs"
    }
  },
  "structures": {
    "history": {
      "consumer": "src/conversation-pages.mjs, src/state.mjs, src/message-media.mjs",
      "fields": [
        "thread.id",
        "thread.kind",
        "thread.status",
        "turns[].id",
        "turns[].items",
        "nextCursor"
      ],
      "rule": "read_thread snapshots can lag the verified owner; history completion is not proof of current completion"
    },
    "ownerState": {
      "consumer": "src/state.mjs, src/bridge.mjs",
      "fields": [
        "id",
        "turnHistory.history.entitiesByKey",
        "threadRuntimeStatus",
        "latestThreadSettings",
        "requests"
      ],
      "rule": "accept only watched conversation from discovered owner; patch baseRevision must match"
    },
    "queueMessage": {
      "consumer": "src/queue.mjs",
      "fields": [
        "id",
        "text",
        "context.prompt",
        "context.imageAttachments",
        "cwd",
        "createdAt",
        "pausedReason"
      ],
      "rule": "official disk is read-only; preserve full raw context and revision when forwarding owner writes"
    },
    "modelCatalog": {
      "consumer": "src/settings.mjs, src/service-tiers.mjs",
      "fields": [
        "tools[].namespace",
        "tools[].name",
        "tools[].inputSchema.properties.model.description"
      ],
      "rule": "parse actual tools/list schema; never invent models"
    },
    "usage": {
      "consumer": "src/usage.mjs",
      "fields": [
        "rateLimitsByLimitId",
        "rateLimits",
        "planType",
        "primary",
        "secondary",
        "usedPercent",
        "windowDurationMins",
        "resetsAt"
      ],
      "rule": "ordinary codex 300-minute quota first, 10080-minute next; separate Spark"
    },
    "officialReadState": {
      "fields": [
        "version",
        "unreadByIdentity",
        "legacyMigration"
      ],
      "consumer": "src/official-read-state.mjs",
      "rule": "Only used to validate the official identity partition and confirm user-triggered notifications. Task statistics use fresh owner hasUnreadTurn and runtime flags; no Remote receipts, history inference or cross-account union. Unavailable state remains unknown. See OFFICIAL-READ-STATE.md."
    },
    "officialTaskState": {
      "fields": [
        "id",
        "hasUnreadTurn",
        "threadRuntimeStatus"
      ],
      "consumer": "src/official-task-state.mjs, src/task-reports.mjs",
      "rule": "0.10.23: fresh dedicated read-only owner subscription, exact task/host/owner checked; supports official Windows x64 26.903.8094.0 local Codex. No receipt files or history cache are read/written; unsupported/unloaded/timeout yields unknown."
    },
    "notifications": {
      "consumer": "src/notification-source.mjs, src/official-task-state.mjs",
      "fields": [
        "id",
        "threadRuntimeStatus.type",
        "threadRuntimeStatus.activeFlags",
        "requests[].id",
        "requests[].method",
        "requests[].params.questions",
        "turnHistory.history.entitiesByKey[].turnId",
        "turnHistory.history.entitiesByKey[].turnStartedAtMs",
        "turnHistory.history.entitiesByKey[].status",
        "turnHistory.history.entitiesByKey[].error.message",
        "turnHistory.history.entitiesByKey[].items"
      ],
      "rule": "Windows other-device notifications use fresh verified owner snapshots only; current runtime gates result/question events; stable IDs deduplicate delivery, never unread or answers; Chat and Work excluded. Supported owner versions follow storage.readState.verifiedVersions."
    }
  },
  "browserApprovals": {
    "implementationVersions": [
      "26.903.8094.0"
    ],
    "scope": "Browser origin approval only; source protocol and isolated regressions verified, live submission not tested; all-sites policy unavailable",
    "evidence": "BROWSER-APPROVALS.md"
  },
  "features": {
    "list": {
      "label": "会话列表",
      "requires": [
        "listThreads"
      ]
    },
    "projects": {
      "label": "项目列表",
      "requires": [
        "listProjects"
      ]
    },
    "read": {
      "label": "会话内容",
      "requires": [
        "readThread"
      ]
    },
    "usage": {
      "label": "使用额度",
      "requires": [
        "usage"
      ]
    },
    "open": {
      "label": "在官方应用打开",
      "requires": [
        "navigate"
      ]
    },
    "wait": {
      "label": "等待任务",
      "requires": [
        "waitThreads"
      ]
    },
    "create": {
      "label": "新建文字会话",
      "requires": [
        "createThread"
      ]
    },
    "projectCreate": {
      "label": "在项目中新建",
      "requires": [
        "createThread",
        "listProjects"
      ]
    },
    "resume": {
      "label": "继续未加载会话",
      "requires": [
        "readThread",
        "sendMessage"
      ]
    },
    "chatSend": {
      "label": "Chat文字续写",
      "requires": [
        "readThread",
        "sendMessage"
      ]
    },
    "send": {
      "label": "发送消息和图片",
      "requires": [
        "initialize",
        "readThread",
        "owner",
        "following",
        "start"
      ]
    },
    "createImages": {
      "label": "带图新建",
      "requires": [
        "initialize",
        "createThread",
        "readThread",
        "owner",
        "following",
        "start"
      ]
    },
    "settings": {
      "label": "修改会话设置",
      "requires": [
        "initialize",
        "readThread",
        "owner",
        "following",
        "settings"
      ]
    },
    "createPermissions": {
      "label": "新建时指定权限",
      "requires": [
        "initialize",
        "createThread",
        "readThread",
        "owner",
        "following",
        "start",
        "settings",
        "setTitle",
        "navigate"
      ]
    },
    "rename": {
      "label": "重命名会话",
      "requires": [
        "readThread",
        "setTitle"
      ]
    },
    "queue": {
      "label": "消息入队、取回和删除",
      "requires": [
        "initialize",
        "readThread",
        "owner",
        "following",
        "queueWrite"
      ]
    },
    "steer": {
      "label": "直接调整方向",
      "requires": [
        "initialize",
        "readThread",
        "owner",
        "following",
        "steer"
      ]
    },
    "queueSteer": {
      "label": "用排队消息调整方向",
      "requires": [
        "initialize",
        "readThread",
        "owner",
        "following",
        "queueWrite",
        "steer"
      ]
    },
    "interrupt": {
      "label": "停止回复",
      "requires": [
        "initialize",
        "readThread",
        "owner",
        "following",
        "interrupt"
      ]
    },
    "questions": {
      "label": "回答阻塞问题",
      "requires": [
        "initialize",
        "readThread",
        "owner",
        "following",
        "userInput"
      ]
    },
    "browserApproval": {
      "label": "网站访问授权",
      "requires": [
        "initialize",
        "readThread",
        "owner",
        "following",
        "mcpElicitation"
      ]
    },
    "taskState": {
      "label": "实时状态、未读统计和通知",
      "requires": [
        "initialize",
        "owner",
        "following"
      ]
    },
    "readReceipt": {
      "label": "同步官方已读",
      "requires": [
        "initialize",
        "readThread",
        "owner",
        "following",
        "readStateChanged"
      ]
    }
  }
}
